            "text": "answer for question_a"
          }
        },
        {
          "text": "question_b",
          "kind": "question",
          "pick": {
            "text": "answer for question_b"
          }
        }
      ]
    },
    {
      "text": "Approve sending this email?",
      "kind": "question",
      "source": "https://docs.langchain.com/oss/python/langgraph/interrupts",
      "parts": [
        {
          "text": "The tool call carries to, subject and body. The resume value can override each of them before the tool runs.",
          "kind": "note"
