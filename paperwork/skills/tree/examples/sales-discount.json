{
  "title": "Decisions: Acme renewal discount",
  "parts": [
    {
      "text": "Acme wants 25% off their $84k renewal or they'll switch – how should I respond?",
      "parts": [
        {
          "text": "Medium risk",
          "kind": "risk"
        },
        {
          "text": "Renewal in 9 days · 212 seats · they asked twice on yesterday's call.",
          "kind": "context"
        }
      ],
      "pick": {
        "text": "Offer 15% instead",
        "parts": [
          {
            "text": "Runs in Salesforce.",
            "kind": "note",
            "source": "https://example-co.atlassian.net/wiki/spaces/SALES/pages/renewal-pricing"
          }
        ],
        "name": "counter"
      },
      "else": [
        {
          "text": "Ask the VP",
          "parts": [
            {
              "text": "Sent in Slack.",
              "kind": "note",
              "source": "https://example-co.slack.com/archives/C0SALES/p1790042799606442"
            }
          ],
          "name": "vp"
        },
        {
          "text": "Accept 25%",
          "parts": [
            {
              "text": "$63k a year · needs sign-off",
              "kind": "risk",
              "source": "https://example-co.atlassian.net/wiki/spaces/SALES/pages/renewal-pricing"
            }
          ]
        }
      ],
      "name": "offer"
    },
    {
      "text": "Tie it to a longer contract?",
      "requires": [
        "offer.counter"
      ],
      "pick": {
        "text": "Only with 2 years",
        "parts": [
          {
            "text": "$71.4k a year until 2028",
            "kind": "consequence",
            "source": "https://example-co.atlassian.net/wiki/spaces/SALES/pages/renewal-pricing"
          }
        ]
      },
      "else": [
        {
          "text": "For one year",
          "parts": [
            {
              "text": "$71.4k · renews at full price",
              "kind": "consequence",
              "source": "https://example-co.atlassian.net/wiki/spaces/SALES/pages/renewal-pricing"
            }
          ]
        }
      ]
    },
    {
      "text": "What should I send along?",
      "requires": [
        "offer.vp"
      ],
      "pick": {
        "text": "The call notes",
        "parts": [
          {
            "text": "Summary of yesterday's call",
            "kind": "consequence",
            "source": "https://example-co.slack.com/archives/C0SALES/p1790042799606441"
          }
        ]
      },
      "else": [
        {
          "text": "Usage and margin",
          "parts": [
            {
              "text": "Margin drops to 41%",
              "kind": "risk",
              "source": "https://example-co.slack.com/archives/C0SALES/p1790042799606440"
            },
            {
              "text": "Agent's note: Finance set a 45% floor for any discount above 20%.",
              "kind": "note",
              "source": "https://example-co.atlassian.net/wiki/spaces/FIN/pages/discount-policy"
            }
          ]
        }
      ]
    },
    {
      "text": "A second decision waits in the queue (1 of 2); the screenshots do not show it.",
      "kind": "note"
    }
  ]
}
