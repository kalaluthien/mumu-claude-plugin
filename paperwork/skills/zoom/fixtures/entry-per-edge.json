              "what": "The lamp glows dimly."
            },
            {
              "id": "high",
              "label": "High",
              "what": "The lamp glows brightly."
            }
          ],
          "edges": [
            {
              "from": "low",
              "to": "high",
              "label": "brighten",
              "what": "The dimmer goes up.",
              "mark": [
                "happy"
              ]
            },
            {
              "from": "high",
              "to": "low",
              "label": "dim",
              "what": "The dimmer goes down.",
              "mark": [
                "happy"
              ]
            }
          ]
        },
        "rules": [
          "repair-starts-low",
