{
  "version": "1",
  "plan": {
    "intent": "Does a repaired lamp start afresh while a switched one resumes?"
  },
  "types": {
    "Lamp": "One lamp with a power switch, a dimmer and a colour switch."
  },
  "scenarios": [
    {
      "slug": "resume-lamp",
      "text": "When a bright lamp is switched off and on, it comes back bright.",
      "walk": [
        {
          "place": "off",
          "does": "The lamp is off.",
          "expects": "No light."
        },
        {
          "place": "on",
          "does": "Someone switches it on.",
          "expects": "The lamp gives light."
        },
        {
          "place": "low",
          "does": "The lamp starts low.",
          "expects": "It glows dimly."
        },
        {
          "place": "high",
          "does": "Someone brightens it.",
          "expects": "It glows brightly."
        },
        {
          "place": "low",
          "does": "Someone dims it.",
          "expects": "It glows dimly."
        },
        {
          "place": "on",
          "does": "The lamp stays lit.",
          "expects": "It gives light."
        },
        {
          "place": "off",
          "does": "Someone switches it off.",
          "expects": "No light."
        }
      ]
    },
    {
      "slug": "repair-lamp",
      "text": "When a bright lamp breaks and is repaired, it starts low.",
      "walk": [
        {
          "place": "on",
          "does": "The lamp is lit.",
          "expects": "It gives light."
        },
        {
          "place": "high",
          "does": "Someone brightens it.",
          "expects": "It glows brightly."
        },
        {
          "place": "on",
          "does": "The lamp is lit.",
          "expects": "It gives light."
        },
        {
          "place": "broken",
          "does": "The lamp breaks.",
          "expects": "No light."
        },
        {
          "place": "on",
          "does": "Someone repairs it.",
          "expects": "The lamp gives light."
        },
        {
          "place": "low",
          "does": "The lamp starts afresh.",
          "expects": "It glows dimly."
        }
      ]
    }
  ],
  "operations": [],
  "title": "Lamp entered per edge",
  "level": {
