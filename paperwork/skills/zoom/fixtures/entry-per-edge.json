  "rules": [
    {
      "slug": "repair-starts-low",
      "kind": "must",
      "formula": "always (all s: Lamp | (s in Broken and after s in On) implies after s in Low)",
      "text": "A repaired lamp starts low, whatever it held before it broke."
    },
    {
      "slug": "resume-brightness",
      "kind": "must",
      "formula": "always (all s: Lamp | (s in High and after (s in Off and after s in On)) implies after after s in High)",
      "text": "A lamp switched off while high comes back high."
    }
