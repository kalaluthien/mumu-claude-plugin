    "id": "web",
    "label": "Web app",
    "what": "Takes orders.",
    "rules": [
     "orders-kept"
    ],
    "link": "view",
    "opens": {
     "kind": "workflow",
     "title": "Checkout",
     "why": "How the web app handles one order.",
     "nodes": [
      {
       "id": "take",
       "label": "Taking order",
       "what": "Read the cart."
      },
      {
       "id": "charge",
       "label": "Charging card",
       "what": "Take the payment."
      }
     ],
     "edges": [
