{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/kalaluthien/mumu-claude-plugin/paperwork/skills/zoom/references/schema/assets/schema.json",
 "title": "Schema",
 "description": "A system as levels, each a statechart and a topology of nodes and node-to-node edges; a node opens the level inside it.",
 "type": "object",
 "required": ["version", "title", "level", "scenarios", "rules"],
 "x-required-rule": {"version": "version-missing"},
 "additionalProperties": false,
 "properties": {
  "version": {"const": "2", "x-rule": "version-missing", "description": "The grammar version this document is written in."},
  "title": {"type": "string", "description": "The system's name."},
  "types": {
   "type": "object",
   "description": "A name the attributes use that no part declares: a sentence saying what it is, opened by `{a, b}` for a set of literal values.",
   "propertyNames": {"$ref": "#/$defs/type-name"},
   "additionalProperties": {"type": "string"}
  },
  "scenarios": {
   "type": "array",
   "description": "A run a reader follows along the chart.",
   "items": {
    "type": "object",
    "required": ["slug", "text", "walk"],
    "additionalProperties": false,
    "properties": {
     "slug": {"$ref": "#/$defs/id"},
     "text": {"type": "string", "description": "What the run shows, in one or two sentences."},
     "walk": {
      "type": "array",
      "items": {
       "type": "object",
       "required": ["place", "does", "expects"],
       "additionalProperties": false,
       "properties": {
        "place": {
         "description": "The node this step is at, or the parts of one level it uses together, in order.",
         "type": ["string", "array"],
         "items": {"$ref": "#/$defs/id"}
        },
        "edge": {"type": "string", "description": "The label of the edge this step takes, where two could."},
        "does": {"type": "string", "description": "What happens in this step."},
        "expects": {"type": "string", "description": "What is true once it has happened."}
       }
      }
     }
    }
   }
  },
  "rules": {
   "type": "array",
   "description": "A property Alloy checks; a `must` set on a transition edge also limits when that edge fires.",
   "items": {
    "type": "object",
    "required": ["slug", "kind", "formula", "meta"],
    "additionalProperties": false,
    "properties": {
     "slug": {"$ref": "#/$defs/id"},
     "kind": {"enum": ["must", "should"]},
     "formula": {"type": "string", "description": "Alloy over the document's names; `s.label` names the event of a transition edge, with no arguments."},
     "meta": {"$ref": "#/$defs/meta"}
    }
   }
  },
  "level": {"$ref": "#/$defs/level"}
 },
 "$defs": {
  "level": {
   "type": "object",
   "required": ["title", "why", "nodes", "edges"],
   "additionalProperties": false,
   "properties": {
    "title": {"type": "string"},
    "why": {"type": "string", "description": "What a reader learns on this level."},
    "subject": {"$ref": "#/$defs/type-name", "description": "The thing whose states the level's transitions move."},
    "initial": {
     "description": "The state each instance starts in, one per region.",
     "type": ["string", "array"],
     "items": {"$ref": "#/$defs/id"}
    },
    "regions": {
     "type": "array",
     "description": "Parallel parts of a statechart: an instance is in one state of each.",
     "items": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string"}}
     }
    },
    "syncs": {
     "type": "array",
     "description": "How regions meet: when one event happens, where a state holds, another happens in the same step.",
     "items": {
      "type": "object",
      "required": ["name", "when", "then"],
      "additionalProperties": false,
      "properties": {
       "name": {"$ref": "#/$defs/id"},
       "when": {"type": "string"},
       "where": {"$ref": "#/$defs/id"},
       "then": {"type": "string"}
      }
     }
    },
    "areas": {
     "type": "array",
     "description": "A group of nodes drawn together.",
     "items": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
       "id": {"$ref": "#/$defs/id"},
       "label": {"type": "string"},
       "unit": {"type": "string", "pattern": "\\S", "description": "The name a person uses for this group, such as a team or a deploy unit.", "x-rule": "area-cohesion"}
      }
     }
    },
    "nodes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["id", "label", "meta"],
      "additionalProperties": false,
      "properties": {
       "id": {"$ref": "#/$defs/id"},
       "label": {"type": "string"},
       "attrs": {"type": "array", "description": "`name: Type` of a part.", "items": {"type": "string"}},
       "region": {"$ref": "#/$defs/id"},
       "area": {"$ref": "#/$defs/id"},
       "rules": {"$ref": "#/$defs/rule-slugs"},
       "opens": {"$ref": "#/$defs/level"},
       "meta": {"$ref": "#/$defs/meta"}
      }
     }
    },
    "edges": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["from", "to", "kind", "label", "meta"],
      "additionalProperties": false,
      "properties": {
       "from": {"$ref": "#/$defs/id"},
       "to": {"$ref": "#/$defs/id"},
       "kind": {"enum": ["call", "transition"]},
       "label": {"type": "string"},
       "attr": {"$ref": "#/$defs/member", "description": "The attribute of the `from` part a call stands for."},
       "changes": {"type": "array", "description": "`Type.attr` a transition may change.", "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*\\.[a-z][A-Za-z0-9]*$", "x-rule": "name-pattern"}},
       "rules": {"$ref": "#/$defs/rule-slugs"},
       "meta": {"$ref": "#/$defs/meta"}
      }
     }
    }
   }
  },
  "meta": {
   "type": "object",
   "required": ["source", "description"],
   "x-required-rule": {"source": "source-missing", "description": "description-missing"},
   "additionalProperties": false,
   "properties": {
    "source": {
     "type": "string",
     "pattern": "^([^\\s:]+:[0-9]+(-[0-9]+)?|https?://\\S+)$",
     "x-rule": "source-pointer",
     "description": "`path:line`, or a url for a system known only from web documents."
    },
    "description": {"type": "string", "pattern": "\\S", "description": "What a reader needs to know, in plain words."}
   }
  },
  "rule-slugs": {"type": "array", "description": "The rules this element holds.", "items": {"$ref": "#/$defs/id"}},
  "id": {"type": "string", "pattern": "^(?!root$)[a-z][a-z0-9]*(-[a-z0-9]+)*$", "description": "`root` names the outermost level.", "x-rule": "name-pattern"},
  "type-name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$", "x-rule": "name-pattern"},
  "member": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "x-rule": "name-pattern"}
 }
}
