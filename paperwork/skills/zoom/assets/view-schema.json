{
 "$schema": "https://json-schema.org/draft-07/schema",
 "title": "zoom view",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "next": {
   "type": "string",
   "description": "The reader's next action or choice, one sentence, shown under the diagram."
  },
  "lang": {
   "enum": [
    "en",
    "ko"
   ],
   "description": "The language of the descriptions, declared on the page; en by default. Terms and the engine's own words stay English."
  },
  "plan": {
   "type": "object",
   "additionalProperties": false,
   "description": "What this view changes from the drawing's defaults.",
   "properties": {
    "views": {
     "type": "array",
     "description": "The diagrams a practitioner of this domain expects: {name, level} where a level draws it, or {name, why} when it is left out.",
     "items": {
      "type": "object",
      "required": [
       "name"
      ],
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string"
       },
       "level": {
        "type": "string",
        "description": "The id of the node that opens it, or root."
       },
       "why": {
        "type": "string"
       }
      }
     }
    },
    "depth": {
     "enum": [
      "overview",
      "working",
      "detailed"
     ]
    },
    "deep": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "shallow": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "max_nodes": {
     "type": "integer"
    },
    "show": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "formulas": {
       "type": "boolean"
      },
      "replay": {
       "type": "boolean"
      },
      "media": {
       "type": "boolean"
      }
     }
    },
    "strict": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "why": {
     "type": "object"
    }
   }
  },
  "screens": {
   "type": "object",
   "description": "Mock screens, read from the code that draws them: \"id\": {title, size, invented?, blocks: [{id, name, type: title|tabs|list|nodes|button|choices|code|text, text, sub, items, active}]}."
  },
  "levels": {
   "type": "object",
   "description": "Per level, keyed root or by the id of the node that opens it: where its nodes sit and how its edges route.",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "nodes": {
      "type": "object",
      "description": "Keyed by node id.",
      "additionalProperties": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "x": {
         "type": "integer",
         "description": "Grid column; leave x and y out to let the engine place the node."
        },
        "y": {
         "type": "integer"
        },
        "ui": {
         "type": "object",
         "required": [
          "screen",
          "block"
         ]
        }
       }
      }
     },
     "edges": {
      "type": "object",
      "description": "Keyed from>to, plus #label when two edges join the same pair.",
      "additionalProperties": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "via": {
         "enum": [
          "left"
         ]
        }
       }
      }
     }
    }
   }
  }
 },
 "definitions": {}
}
