{
 "version": "2",
 "title": "zoom",
 "types": {
  "Verdict": "{pass, counterexample} What Alloy says of a rule."
 },
 "scenarios": [
  {
   "slug": "show-a-system",
   "text": "Someone asks how a system works: the document is written, accepted and drawn.",
   "walk": [
    {
     "place": "document",
     "does": "Write the system as a document.",
     "expects": "It holds levels, each with its nodes and edges."
    },
    {
     "place": "drafted",
     "does": "Open the document's life.",
     "expects": "It starts as a draft."
    },
    {
     "place": "checked",
     "does": "Run the checker until it prints ok.",
     "expects": "The document fits the grammar and the structure rules."
    },
    {
     "place": "shown",
     "does": "Build the page.",
     "expects": "A self-contained page shows the system."
    }
   ]
  },
  {
   "slug": "prove-a-rule",
   "text": "Someone asks whether a promise holds: Alloy answers on the checked document.",
   "walk": [
    {
     "place": "checked",
     "does": "Start from an accepted document.",
     "expects": "Its rules are in Alloy over its own names."
    },
    {
     "place": "proved",
     "does": "Run the prover.",
     "expects": "Each rule has a verdict."
    },
    {
     "place": "drafted",
     "edge": "fix a broken rule",
     "does": "Read the counterexample and change the document.",
     "expects": "The document goes back through the checker."
    }
   ]
  }
 ],
 "rules": [
  {
   "slug": "proof-after-check",
   "kind": "must",
   "formula": "all document: SchemaDocument | document.proveTheRules implies once document.passTheChecker",
   "meta": {
    "source": "paperwork/skills/zoom/references/prove.md:1",
    "description": "Alloy reads only what the checker accepted, since a name that points nowhere gives no answer worth reading."
   }
  }
 ],
