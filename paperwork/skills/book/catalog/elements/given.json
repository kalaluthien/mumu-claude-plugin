  "move": "compute",
  "level": "apply",
  "diff": "2",
  "elements": [
   {
    "el": "stem",
    "text": "Odds are 1/2, 1/4 and 1/4. Estimate the average number of questions.",
    "asks": "value"
   },
   {
    "el": "given",
    "given": {
     "odds": "1/2, 1/4, 1/4"
    },
    "ans": 1.5,
    "tol": 0.05,
    "unit": "questions",
    "lo": "Too low: even the popular dish costs a whole question.",
    "hi": "Too high: the popular dish costs only one question, half of the time.",
    "why": "0.5 × 1 + 0.25 × 2 + 0.25 × 2 = 1.5."
   }
  ]
 }
