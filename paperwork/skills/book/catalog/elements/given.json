   "type": "html",
   "req": true
  },
  "hi": {
   "type": "html",
   "req": true
  },
  "why": {
   "type": "html",
   "req": true
  }
 },
 "render": "<div data-p=\"input\" data-ans=\"{ans}\" data-tol=\"{tol}\"><span>{unit}</span></div><p data-p=\"lo\">{lo}</p><p data-p=\"hi\">{hi}</p><p data-p=\"why\">{why}</p>",
 "checks": [
