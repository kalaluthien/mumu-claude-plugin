{
 "id": "steps",
 "family": "visual",
 "why": "frames that change one object of the scene each",
 "zone": "body",
 "kinds": [
  "frames"
 ],
 "slots": {
  "list": {
   "type": "list",
   "req": true,
   "of": {
    "svg": {
     "type": "html",
     "req": true
    },
    "note": {
     "type": "html",
     "req": true
    },
    "delta": {
     "type": "str",
     "req": true
    },
    "state": {
     "type": "obj",
     "req": true
    }
   },
   "doc": "one frame each: svg, note, the object or group it changes, the scene state after it"
  },
  "read": {
   "type": "html",
   "req": true,
   "doc": "how to read the frames"
  }
 },
 "render": "<ol>{#list}<li>{svg}<p>{note}</p></li>{/list}</ol><p data-c=\"read\">{read}</p>",
 "checks": [
  {
   "id": "one-change",
   "breaks": [
    {
     "set": "elements.1.list.2.state.label",
     "to": "dessert"
    }
   ]
  },
  {
   "id": "one-change",
   "breaks": [
    {
     "set": "elements.1.list.1.delta",
     "to": "plate"
    }
   ]
  }
 ],
 "example": {
  "kind": "frames",
  "tactic": "frames",
  "fkind": "conceptual",
  "caption": "Halving 8 candidates takes three answers.",
  "elements": [
   {
    "el": "scene",
    "objects": [
     "bar",
     "label"
    ],
    "groups": {}
   },
   {
    "el": "steps",
    "list": [
     {
      "svg": "<svg viewBox=\"0 0 200 60\"><rect x=\"0\" y=\"20\" width=\"60\" height=\"20\"/><text x=\"4\" y=\"14\">8 left</text></svg>",
      "note": "Before any answer: 8 dishes.",
      "delta": "bar",
      "state": {
       "bar": 8,
       "label": "menu"
      }
     },
     {
      "svg": "<svg viewBox=\"0 0 200 60\"><rect x=\"0\" y=\"20\" width=\"60\" height=\"20\"/><text x=\"4\" y=\"14\">4 left</text></svg>",
      "note": "One answer: 4 dishes.",
      "delta": "bar",
      "state": {
       "bar": 4,
       "label": "menu"
      }
     },
     {
      "svg": "<svg viewBox=\"0 0 200 60\"><rect x=\"0\" y=\"20\" width=\"60\" height=\"20\"/><text x=\"4\" y=\"14\">2 left</text></svg>",
      "note": "Two answers: 2 dishes.",
      "delta": "bar",
      "state": {
       "bar": 2,
       "label": "menu"
      }
     }
    ],
    "read": "Each frame is one answer; the bar halves."
   },
   {
    "el": "alt",
    "kind": "Three frames of one bar",
    "encodes": "bar width is the number of dishes left",
    "point": "each answer halves the bar"
   }
  ]
 }
}