{
 "id": "items",
 "family": "problem",
 "why": "items to sort into bins, put in order, or select",
 "zone": "items",
 "kinds": [
  "task-sort",
  "task-order",
  "task-select"
 ],
 "slots": {
  "bins": {
   "type": "list",
   "doc": "sort: the bins"
  },
  "list": {
   "type": "list",
   "req": true,
   "of": {
    "text": {
     "type": "html",
     "req": true
    },
    "why": {
     "type": "str",
     "req": true
    },
    "bin": {
     "type": "str"
    },
    "ok": {
     "type": "bool"
    }
   },
   "doc": "items; order tasks list them in the right order"
  }
 },
 "render": {
  "task-sort": "<ul data-p=\"items\" data-cats=\"{bins!a}\">{#list}<li data-cat=\"{bin!a}\" data-why=\"{why!a}\">{text}</li>{/list}</ul>",
  "task-order": "<ol data-p=\"items\">{#list}<li data-why=\"{why!a}\">{text}</li>{/list}</ol>",
  "task-select": "<ul data-p=\"items\">{#list}<li[ok:  data-ok] data-why=\"{why!a}\">{text}</li>{/list}</ul>"
 },
 "checks": [
  {
   "id": "items-fit",
   "breaks": [
    {
     "set": "elements.1.list.0.bin",
     "to": "Nowhere"
    }
   ]
  }
 ],
 "example": {
  "kind": "task-sort",
  "move": "decide",
  "level": "apply",
  "diff": "2",
  "elements": [
   {
    "el": "stem",
    "text": "Sort each first question for a menu of 16 dishes by what its worst answer leaves.",
    "asks": "category"
   },
   {
    "el": "items",
    "bins": [
     "8 left",
     "More than 8"
    ],
    "list": [
     {
      "text": "Is it among the first eight?",
      "bin": "8 left",
      "why": "Either answer keeps 8 of the 16."
     },
     {
      "text": "Is it the soup?",
      "bin": "More than 8",
      "why": "A no keeps 15 dishes."
     },
     {
      "text": "Is its number odd?",
      "bin": "8 left",
      "why": "Odd and even numbers split 16 evenly."
     },
     {
      "text": "Is it one of the four desserts?",
      "bin": "More than 8",
      "why": "A no keeps the 12 others."
     }
    ]
   }
  ]
 }
}