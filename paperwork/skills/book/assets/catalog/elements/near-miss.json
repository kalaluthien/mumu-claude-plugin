{
 "id": "near-miss",
 "family": "problem",
 "why": "an option one condition short of the rule",
 "zone": "opts",
 "kinds": [
  "ask",
  "probe"
 ],
 "slots": {
  "text": {
   "type": "html",
   "req": true
  },
  "why": {
   "type": "html",
   "req": true,
   "doc": "names the missing condition"
  },
  "missing": {
   "type": "str",
   "req": true,
   "writer": true,
   "doc": "the one absent condition"
  },
  "right_when": {
   "type": "str",
   "writer": true
  },
  "exhibit": {
   "type": "el:exhibit",
   "doc": "an exhibit inside the option (compare-designs)"
  },
  "mark": {
   "type": "int",
   "doc": "the exhibit mark this option names"
  },
  "layer": {
   "type": "enum",
   "values": [
    "first-order",
    "second-order",
    "flip"
   ],
   "doc": "with change: which effect this option states"
  }
 },
 "render": "<li>{exhibit@exhibit}{text}<p data-p=\"why\">{why}</p></li>",
 "checks": [
  {
   "id": "near-miss-names",
   "breaks": [
    {
     "set": "elements.4.missing",
     "to": "weighted"
    }
   ]
  }
 ],
 "example": {
  "kind": "ask",
  "move": "decide",
  "level": "apply",
  "diff": "2",
  "elements": [
   {
    "el": "stem",
    "text": "A menu has 8 dishes, each ordered equally often. Which first question keeps the worst case smallest?",
    "asks": "move"
   },
   {
    "el": "setup",
    "facts": [
     "8 dishes",
     "each ordered equally often"
    ]
   },
   {
    "el": "answer",
    "text": "Is it among dishes 1 to 4?",
    "why": "Either answer leaves 4 of the 8 dishes."
   },
   {
    "el": "rival",
    "text": "Is it dish 1?",
    "why": "A no still leaves 7 of the 8 dishes.",
    "belief": "first-order",
    "right_when": "one dish holds most of the orders",
    "ruled_out_by": [
     1
    ]
   },
   {
    "el": "near-miss",
    "text": "Is it dish 1, 2, 3 or 5?",
    "why": "It also splits 4 and 4, but the dishes are not contiguous, so the next question cannot halve a range.",
    "missing": "contiguous",
    "right_when": "any set of 4 works for one question"
   }
  ]
 }
}