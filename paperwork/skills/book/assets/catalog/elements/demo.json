{
 "id": "demo",
 "family": "visual",
 "why": "a book.js widget the reader drives, with one control per claimed variable",
 "zone": "body",
 "kinds": [
  "fig"
 ],
 "slots": {
  "name": {
   "type": "str",
   "req": true,
   "doc": "the D[name] demo in book.js"
  },
  "controls": {
   "type": "list",
   "req": true
  },
  "measures": {
   "type": "list",
   "req": true
  },
  "question": {
   "type": "html",
   "req": true
  }
 },
 "render": "<div class=\"demo\" data-demo=\"{name!a}\"></div><p>{question}</p>",
 "checks": [
  {
   "id": "demo-measures",
   "breaks": [
    {
     "set": "elements.0.measures",
     "to": []
    }
   ]
  }
 ],
 "example": {
  "kind": "fig",
  "tactic": "plot",
  "fkind": "computed",
  "caption": "Drag the odds and watch the average fall.",
  "elements": [
   {
    "el": "demo",
    "name": "odds",
    "controls": [
     "odds of the popular dish"
    ],
    "measures": [
     "average questions"
    ],
    "question": "At which odds does the average reach 1.5?"
   },
   {
    "el": "alt",
    "kind": "Interactive plot",
    "encodes": "average questions against the odds of one dish",
    "point": "more skew, fewer questions"
   }
  ]
 }
}