 "scripts": [
  {
   "letters": "A-Za-z",
   "min": 4,
   "stem": 0
  }
 ],
 "ngram": "words",
 "stop": [
  "and",
  "are",
  "for",
  "is",
  "that",
  "the",
  "with"
 ],
 "stem_end": "(\\?|\\.)$",
 "neg_stem": "\\b(not|except|least|incorrect|false)\\b",
 "concede": "(?i)\\b(true, but|right, but|also correct|not wrong)\\b",
 "hedge": "\\b(somehow|enough|just|entirely|completely|whatever)\\b",
 "cue_words": "\\b(always|never|every|all|only|cannot|none|must|no one|nothing)\\b",
 "claim_cue": "\\b(always|never|only|cannot|must|proves?|guarantees?)\\b",
 "cite": "et al",
 "catch_all": [
  "(all|none|both) of the above",
  "cannot be determined"
 ],
 "head_sent": "[.?!]$",
 "fact_sent": "[.!?]$",
 "pos_ref": "\\b(frame|scene|option) \\d+\\b|\\b(first|second|third|last) option\\b",
 "fourth_wall": [
  "\\b(this|the) (book|chapter|section) (does not|doesn't|will not|won't) (cover|discuss|address)",
  "\\b(out of|beyond the) scope\\b",
  "\\b(another|a separate|a companion) (artifact|book|document)\\b",
  "\\b(at|per) the (user|reader|requester)'?s? request\\b",
  "\\b(we|I) (decided|chose) (to )?(omit|exclude|leave out|drop)",
  "\\b(previous|earlier|this) (version|edition|revision)\\b"
 ],
 "inline_def": "\\b([A-Z][A-Za-z0-9+]{0,5}) (?:is|means|stands for)\\b",
 "fonts": {
  "css": "https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700&family=Noto+Serif:wght@600;700&family=JetBrains+Mono:wght@400;500&display=swap",
  "sans": "\"Noto Sans\"",
  "serif": "\"Noto Serif\""
 },
 "alt_words": 5,
 "unseen_ref": "\\b(?:this|that|the following|the above) (?:draft|log|message|reply|excerpt|passage|paragraph|output)\\b|\\b(?:sentence|citation|line|item|entry) \\d+\\b|\\b(?:above|below)\\b",
 "label_end": "\\b\\w+ (?:answer|response|choice|reading)\\.?$",
 "symbol_def": "(?:^|[\\s(,])(\\$[^$]{1,15}\\$|[A-Za-z]) (?:denotes|represents|stands for|is the number of)\\b",
 "list_item": 4,
 "quant": "\\d+(?:\\.\\d+)?\\s?(?:%|percent)|\\b\\d[\\d,]*\\s+(?:participants|respondents|subjects|students)\\b",
 "causal": "\\b(?:caus(?:es|ed)|led to|leads to|improv(?:es|ed)|reduc(?:es|ed)|increas(?:es|ed)|decreas(?:es|ed))\\b",
 "sample": "\\b[nN]\\s?=\\s?\\d|\\b\\d[\\d,]*\\s+(?:participants|people|users|subjects|students|respondents|adults|children|sites|teams|trials|sessions)\\b",
 "no_sample": "\\b(?:theor\\w*|review|survey|meta-analysis|case analysis|position|argument|essay|guideline|standard|specification|book|blog|article|report|ruling|decision|secondary|claim|undisclosed)\\b",
 "hedges": [
  [
   "proves?",
   "established",
   "demonstrates?"
  ],
  [
   "shows?",
   "showed",
   "found"
  ],
  [
   "suggests?",
   "may",
   "reported",
   "argues?"
  ]
 ],
 "counters": "(?:people|users|participants|items|rows|columns|tasks|steps|runs|minutes|seconds|hours|days|percent|%)",
 "hypothetical": "\\b(?:if|suppose|say|imagine|hypothetically)\\b",
 "absolute": "\\b(?:only|never|always|first ever|never before|none|no (?:other )?\\w+ (?:had|has|could|can))\\b",
 "note_label": "(?:^|\\s)[A-Z][a-z ]{1,16}:\\s",
 "quant_skip": "\\d+% (?:confidence|credible|prediction) interval",
 "mutate": []
}