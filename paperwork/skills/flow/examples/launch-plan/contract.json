{
  "title": "Release plan",
  "purpose": "Shows who does what, and what waits on what, from the first line of code to a published release.",
  "sources": [
    {"id": "release-guide", "path": "https://example.com/team/release-guide", "says": "The steps of a release, who owns each and what each waits on."}
  ],
  "terms": [
    {"term": "code freeze", "meaning": "the point after which only fixes of review findings may land before the release", "avoid": ["lockdown"]}
  ],
  "areas": [
    {"id": "team", "label": "Team", "purpose": "The people who write and review the change."},
    {"id": "automation", "label": "Automation", "purpose": "The machines that test and publish."}
  ],
  "levels": [
    {"id": "release", "title": "release", "kind": "plan", "nodes": ["developer", "reviewer", "ci-runner", "package-registry"], "about": "One release from code to a published package."}
  ],
  "nodes": [
    {"id": "developer", "label": "Developer", "tag": "actor", "area": "team", "purpose": "Writes the change and fixes what the review finds.", "evidence": ["release-guide"], "basis": "documented"},
    {"id": "reviewer", "label": "Reviewer", "tag": "actor", "area": "team", "purpose": "Reads the change and approves it or sends it back.", "evidence": ["release-guide"], "basis": "documented"},
    {"id": "ci-runner", "label": "macOS runner", "tag": "job", "area": "automation", "purpose": "Runs the tests and builds the package.", "evidence": ["release-guide"], "basis": "documented"},
    {"id": "package-registry", "label": "Package registry", "tag": "dataStore", "area": "automation", "purpose": "Holds each published version for users to install.", "evidence": ["release-guide"], "basis": "documented"}
  ],
  "tasks": [
    {"id": "write-code", "level": "release", "node": "developer", "label": "Write the change", "tag": "work", "purpose": "Makes the code change the release ships.", "info": {"done": "the branch builds locally"}, "evidence": ["release-guide"]},
    {"id": "write-notes", "level": "release", "node": "developer", "label": "Write release notes", "tag": "work", "purpose": "Says what changed for users.", "info": {"outputs": ["release notes"]}, "evidence": ["release-guide"]},
    {"id": "run-tests", "level": "release", "node": "ci-runner", "label": "Run the tests", "tag": "work", "purpose": "Proves the change breaks nothing known.", "info": {"done": "every test passes"}, "evidence": ["release-guide"]},
    {"id": "review-code", "level": "release", "node": "reviewer", "label": "Review the change", "tag": "review", "purpose": "Finds what the tests cannot.", "info": {"refuses": ["a public interface changed without a note"]}, "evidence": ["release-guide"]},
    {"id": "fix-findings", "level": "release", "node": "developer", "label": "Fix review findings", "tag": "work", "purpose": "Answers each finding of the review.", "evidence": ["release-guide"]},
    {"id": "merge-change", "level": "release", "node": "developer", "label": "Merge to main", "tag": "work", "purpose": "Puts the reviewed change on the main branch.", "after": ["code-freeze"], "evidence": ["release-guide"]},
    {"id": "build-package", "level": "release", "node": "ci-runner", "label": "Build the package", "tag": "work", "purpose": "Turns the main branch into one versioned package.", "evidence": ["release-guide"]},
    {"id": "publish-package", "level": "release", "node": "package-registry", "label": "Publish the version", "tag": "work", "purpose": "Makes the package installable.", "info": {"done": "the version shows in the index"}, "evidence": ["release-guide"]}
  ],
  "edges": [
    {"id": "asks-tests", "level": "release", "from": "write-code", "to": "run-tests", "label": "push the branch", "tag": "request", "evidence": ["release-guide"]},
    {"id": "asks-review", "level": "release", "from": "write-code", "to": "review-code", "label": "open a review", "tag": "request", "evidence": ["release-guide"]},
    {"id": "sends-findings", "level": "release", "from": "review-code", "to": "fix-findings", "label": "send the findings", "tag": "request", "evidence": ["release-guide"]},
    {"id": "waits-tests", "level": "release", "from": "run-tests", "to": "merge-change", "label": "tests pass", "tag": "wait", "evidence": ["release-guide"]},
    {"id": "waits-approval", "level": "release", "from": "review-code", "to": "merge-change", "label": "the review approves", "tag": "wait", "evidence": ["release-guide"]},
    {"id": "asks-build", "level": "release", "from": "merge-change", "to": "build-package", "label": "tag the release", "tag": "request", "evidence": ["release-guide"]},
    {"id": "hands-package", "level": "release", "from": "build-package", "to": "publish-package", "label": "upload the package", "tag": "request", "evidence": ["release-guide"]},
    {"id": "waits-notes", "level": "release", "from": "write-notes", "to": "publish-package", "label": "notes are ready", "tag": "wait", "info": {"until": "the notes are merged"}, "evidence": ["release-guide"]}
  ],
  "milestones": [
    {"id": "code-freeze", "level": "release", "label": "Code freeze", "after": ["fix-findings", "run-tests"], "purpose": "After it only the merge and the release steps run."}
  ],
  "claims": [
    {"id": "reviewed-first", "title": "reviewed-first", "kind": "guarantee", "statement": "No change reaches {merge-change} before {review-code} ends.", "on": ["merge-change"], "evidence": ["release-guide"]},
    {"id": "notes-owner", "title": "notes-owner", "kind": "guarantee", "statement": "The release notes are approved before {publish-package}.", "status": "unknown", "fault": "No source says who approves the release notes before {publish-package}.", "on": ["write-notes"]}
  ],
  "questions": [
    {"id": "blocks-what", "asks": "What must end before the version is published?", "answers": ["hands-package", "waits-notes", "code-freeze"]},
    {"id": "who-owns", "asks": "Who owns each step?", "answers": ["developer", "reviewer", "ci-runner", "package-registry"]},
    {"id": "notes-approval", "asks": "Who approves the release notes?", "answers": ["notes-owner"]}
  ]
}
