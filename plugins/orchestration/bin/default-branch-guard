#!/bin/sh
# Git pre-commit: refuse a commit on the repository's default branch, so work
# lands only through a pull request. A worker links it into the checkout it claims.
# The default branch is origin's HEAD, else init.defaultBranch, else main.

branch=$(git symbolic-ref --quiet --short HEAD) || exit 0  # detached: rebase, bisect
default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
default=${default#origin/}
[ -n "$default" ] || default=$(git config init.defaultBranch)
[ -n "$default" ] || default=main
[ "$branch" = "$default" ] || exit 0

echo "pre-commit: commits on the default branch \"$branch\" are refused; commit on the claimed branch <topic>-<issue>." >&2
exit 1
