#!/usr/bin/env python3
"""Refuse a `gh pr merge` that is not pinned to a sha a reviewer approved.

PreToolUse hook on Bash. A `gh pr merge` anywhere in the command -- after a
newline, an env prefix, a wrapper such as `rtk`, or inside `( )` / `$( )` --
-- or in the body of a `-c '...'` -- passes only when it carries `--match-head-commit <sha>`, that sha is the PR's
head, and the PR holds a comment whose first line is `Approved <sha>`. A payload
that cannot be read, a command that cannot be lexed yet reads `gh ... pr merge`,
and a PR that cannot be read are refused (exit 2). A command without `merge`
exits 0 unread; `pr merge` inside a message or a search is not a merge.
"""
import json
import os
import re
import shlex
import subprocess
import sys

SEPARATORS = set(";&|()\n")


def refuse(reason):
    print(f"approved: {reason}", file=sys.stderr)
    sys.exit(2)


def merges(command):
    """Yield (global repo, args after `pr merge`) for each `gh ... pr merge` found."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|()\n")
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    segment, previous = [], None
    for word in list(lexer) + [";"]:
        if word and set(word) <= SEPARATORS:
            yield from gh_merge(segment)
            segment = []
        else:
            if previous == "-c":  # the body of `bash -c '...'` is a command of its own
                yield from merges(word)
            segment.append(word)
        previous = word


def gh_merge(words):
    for i, word in enumerate(words):
        if os.path.basename(word) != "gh":
            continue
        rest, repo = words[i + 1:], None
        while rest and (rest[0] in ("-R", "--repo") and len(rest) >= 2 or rest[0].startswith("--repo=")):
            if rest[0].startswith("--repo="):
                repo, rest = rest[0].split("=", 1)[1], rest[1:]
            else:
                repo, rest = rest[1], rest[2:]
        if rest[:2] == ["pr", "merge"]:
            yield repo, rest[2:]


def option(args, *names):
    for i, arg in enumerate(args):
        for name in names:
            if arg == name and i + 1 < len(args):
                return args[i + 1]
            if name.startswith("--") and arg.startswith(name + "="):
                return arg.split("=", 1)[1]
    return None


def target(args):
    takes_value = {"-R", "--repo", "--match-head-commit", "-b", "--body", "-F", "--body-file",
                   "-t", "--subject", "-A", "--author-email"}
    skip = False
    for arg in args:
        if skip:
            skip = False
        elif arg in takes_value:
            skip = True
        elif not arg.startswith("-"):
            return arg
    return None


def check(repo, args, cwd):
    sha = option(args, "--match-head-commit")
    if not sha:
        refuse("`gh pr merge` must carry `--match-head-commit <sha>`, the sha the reviewer approved")
    view = ["gh", "pr", "view"] + ([target(args)] if target(args) else []) + ["--json", "headRefOid,comments"]
    repo = option(args, "-R", "--repo") or repo
    if repo:
        view += ["-R", repo]
    run = subprocess.run(view, capture_output=True, text=True, cwd=cwd)
    try:
        pr = json.loads(run.stdout) if run.returncode == 0 else None
        head = pr["headRefOid"]
    except (ValueError, KeyError, TypeError):
        refuse(f"could not read the PR ({' '.join(view)}): {run.stderr.strip() or run.stdout.strip()}")
    if sha != head:
        refuse(f"--match-head-commit {sha} is not the PR head {head}; the approval, if any, is stale")
    first_lines = [c["body"].strip().splitlines()[0].strip() for c in pr["comments"] if c["body"].strip()]
    if f"Approved {head}" not in first_lines:
        refuse(f"no PR comment opens with `Approved {head}`; launch the reviewer agent at this sha")


raw = sys.stdin.read()
if "merge" not in raw:
    sys.exit(0)
try:
    payload = json.loads(raw)
    command = payload["tool_input"]["command"]
    if not isinstance(command, str):
        raise TypeError(f"command is {type(command).__name__}")
    cwd = payload.get("cwd")
    cwd = cwd if cwd and os.path.isdir(cwd) else None
except (ValueError, KeyError, TypeError) as err:
    refuse(f"could not read the payload ({type(err).__name__}: {err})")
try:
    found = list(merges(command))
except ValueError as err:  # e.g. an apostrophe in a heredoc body
    if re.search(r"\bgh\b[^;&|\n]*\bpr\s+merge\b", command):
        refuse(f"could not lex the command ({err}); run `gh pr merge` on its own line")
    sys.exit(0)
for repo, args in found:
    check(repo, args, cwd)
