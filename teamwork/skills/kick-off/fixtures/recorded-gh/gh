#!/usr/bin/env python3
"""Answer each gh call from the tape GH_TAPE names, so a fixture check reads GitHub once per call, never once per run, and spends none of its rate limit after.

usage: gh <gh arguments>
The tape is `<Claude config folder>/teamwork/recorded-gh/<GH_TAPE>.json`, kept on this machine, since a recorded answer holds the token's
headers; delete it to read GitHub again. A call the tape lacks is answered by the next gh on PATH, and the answer joins the tape. A call made
again gets its answers in recorded order, counted in GH_TAPE_STATE when set, the last one repeated after them, since a body read before and
after an edit answers differently."""
import fcntl
import hashlib
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

HERE = pathlib.Path(__file__).resolve().parent


def without_etag(args):
    """ARGS without their `-H If-None-Match: …`, which the reader's cache adds or not, so one call has one name and the tape a full answer."""
    drop = {j for i, a in enumerate(args) if i and a.startswith("If-None-Match:") and args[i - 1] == "-H" for j in (i - 1, i)}
    return [a for i, a in enumerate(args) if i not in drop]


def key(args, text):
    """The call as the tape names it: the repository GH_REPO sets, the arguments and the input's hash."""
    return json.dumps([os.environ.get("GH_REPO", ""), *without_etag(args), hashlib.sha1(text.encode()).hexdigest()[:12] if text else ""])


def locked(path):
    """An exclusive hold on PATH, by a lock file in the temporary folder, so none lands beside the tape."""
    handle = open(pathlib.Path(tempfile.gettempdir()) / f"recorded-gh-{hashlib.sha1(str(path).encode()).hexdigest()[:12]}.lock", "w")
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def load(path):
    try:
        return json.loads(pathlib.Path(path).read_text())
    except (OSError, ValueError):
        return {}


def save(path, data):
    spare = pathlib.Path(f"{path}.{os.getpid()}.tmp")
    spare.write_text(json.dumps(data, indent=1, sort_keys=True) + "\n")
    os.replace(spare, path)


def live(args, text):
    """The answer of the next gh on PATH, its kept ETag dropped so the tape holds a full answer."""
    rest = os.pathsep.join(p for p in os.environ["PATH"].split(os.pathsep) if pathlib.Path(p).resolve() != HERE)
    gh = shutil.which("gh", path=rest) or sys.exit("recorded-gh: no gh on PATH to record from")
    p = subprocess.run([gh, *without_etag(args)], input=text, capture_output=True, text=True)
    return {"stdout": p.stdout, "stderr": p.stderr, "code": p.returncode}


def main(args):
    name = os.environ.get("GH_TAPE") or sys.exit("recorded-gh: set GH_TAPE to the tape's name")
    tape = pathlib.Path(os.environ.get("CLAUDE_CONFIG_DIR") or pathlib.Path.home() / ".claude") / "teamwork" / "recorded-gh" / f"{name}.json"
    tape.parent.mkdir(parents=True, exist_ok=True)
    text = sys.stdin.read() if any(a.endswith("@-") for a in args) else ""
    call = key(args, text)
    with locked(tape):
        answers = load(tape).get(call, [])
    state = os.environ.get("GH_TAPE_STATE")
    if state:
        with locked(state):
            counts = load(state)
            turn = counts.get(call, 0)
            counts[call] = turn + 1
            save(state, counts)
    else:
        turn = 0
    if turn < len(answers):
        answer = answers[turn]
    else:
        answer = live(args, text)
        with locked(tape):
            data = load(tape)
            data.setdefault(call, []).append(answer)
            save(tape, data)
    sys.stdout.write(answer["stdout"])
    sys.stderr.write(answer["stderr"])
    return answer["code"]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
