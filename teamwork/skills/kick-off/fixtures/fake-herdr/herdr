#!/usr/bin/env python3
"""Stand in for herdr: log each call and keep agents, tabs and workspaces in a JSON state file.

An agent's name picks the dialog it shows: `trust` the folder trust dialog at start, `slow` its prompt typed but unsent,
and a `blocked` agent with a `screen` the exit dialog of background work; each clears on the key that answers it.
A prompt to a `blocked` agent is refused `agent_blocked`, an `unblock` agent refuses its first prompt so, and an `unseen` agent
takes a prompt but never shows it, a `late` agent's start is refused `timeout` and it comes up unnamed in its pane two lists later, a `never` agent's start is refused `timeout` and nothing comes up, and a `refuse` agent refuses every prompt `agent_pane_closed`; `agent wait` ends a working
agent's turn at once and times out on a blocked one, an agent with `flip` swaps idle and working at each list, or at every `period`th (`"flip": "blocked"` swaps blocked and working), and an agent with `move`, or one started with `moving` in its
name, moves to that pane after the `move_after`th list that shows it (default the first). `pane list` lists each agent's pane, and a pane, tab or workspace close shuts every agent in it. A target no agent has is refused
`agent_not_found`; with TEAMWORK_FAKE_HERDR_CONFIG set to a Claude config folder, a `/rename <name>` prompt is recorded in that folder's transcript, as
Claude Code does.
It answers only the calls of CALLS, the ones the plugin makes, with their options; any other is refused as herdr refuses one, exit 1, and appended to
the file TEAMWORK_FAKE_HERDR_REFUSED names, so a runner fails on a call the real herdr may not take."""
import json, os, pathlib, sys

# (verb, noun) -> (the positional words it takes, or a minimum as a negative count, and each option with how many values it takes)
CALLS = {("agent", "list"): (0, {}), ("agent", "read"): (1, {"--source": 1, "--ansi": 0}),
         ("agent", "start"): (1, {"--kind": 1, "--pane": 1, "--timeout": 1}), ("agent", "rename"): (2, {}), ("agent", "prompt"): (2, {}),
         ("agent", "send-keys"): (-2, {}), ("agent", "wait"): (1, {"--until": 1, "--timeout": 1}),
         ("pane", "read"): (1, {}), ("pane", "send-text"): (2, {}), ("pane", "rename"): (2, {}), ("pane", "list"): (0, {}), ("pane", "close"): (1, {}),
         ("tab", "list"): (0, {"--workspace": 1}), ("tab", "create"): (0, {"--workspace": 1, "--cwd": 1, "--label": 1, "--no-focus": 0}),
         ("tab", "rename"): (2, {}), ("tab", "close"): (1, {}),
         ("workspace", "create"): (0, {"--cwd": 1, "--label": 1, "--no-focus": 0}), ("workspace", "close"): (1, {})}


def known(argv):
    """Whether ARGV is a call of CALLS with only its options, an `agent start` taking its command after `--`."""
    if tuple(argv[:2]) not in CALLS:
        return False
    count, options = CALLS[tuple(argv[:2])]
    words, rest = argv[2:], []
    if argv[:2] == ["agent", "start"] and "--" in words:
        words, rest = words[:words.index("--")], words[words.index("--") + 1:]
    positional, at = [], 0
    while at < len(words):
        if words[at].startswith("--") and words[at] in options:
            at += 1 + options[words[at]]
            if at > len(words):
                return False
        elif words[at].startswith("--"):
            return False
        else:
            positional.append(words[at])
            at += 1
    return (len(positional) >= -count if count < 0 else len(positional) == count) and (argv[:2] != ["agent", "start"] or bool(rest))


state_path = pathlib.Path(os.environ["TEAMWORK_FAKE_HERDR_STATE"])
state = json.loads(state_path.read_text())
argv = sys.argv[1:]
with open(os.environ.get("TEAMWORK_FAKE_HERDR_LOG", os.devnull), "a") as log:
    log.write(json.dumps(argv) + "\n")
code = 0
ok = lambda result=None: print(json.dumps({"result": result or {}}))
if not known(argv):
    print(json.dumps({"error": {"code": "invalid_command", "message": f"herdr {' '.join(argv)}: no such command or option"}}))
    print(f"error: herdr {' '.join(argv)}: no such command or option", file=sys.stderr)
    with open(os.environ.get("TEAMWORK_FAKE_HERDR_REFUSED", os.devnull), "a") as refused:
        refused.write(f"herdr {' '.join(argv)}\n")
    sys.exit(1)


def new_pane(workspace):
    state["n"] += 1
    state["tabs"].append({"tab_id": f"{workspace}:t{state['n']}", "workspace_id": workspace, "label": ""})
    return {"pane_id": f"{workspace}:p{state['n']}", "tab_id": f"{workspace}:t{state['n']}"}


def by_pane(pane):
    return next((agent for agent in state["agents"] if pane in (agent["pane_id"], agent["name"])), {})


def option(name):
    return argv[argv.index(name) + 1] if name in argv else None


head = argv[:2]
if head == ["agent", "list"]:
    for agent in state["agents"]:
        agent["hidden"] = max(agent.get("hidden", 0) - 1, 0)
    ok({"agents": [{k: value for k, value in agent.items() if k not in ("ticks", "screen", "move", "move_after", "lists", "hidden")} for agent in state["agents"] if not agent["hidden"]]})
    for agent in state["agents"]:  # a pane herdr moved, as from w9:p1 to w4:pF
        agent["lists"] = agent.get("lists", 0) + 1
        if agent.get("move") and agent["lists"] >= agent.get("move_after", 1):
            agent["pane_id"], agent["tab_id"], agent["workspace_id"] = agent["move"], agent["move"].replace(":p", ":t"), agent["move"].split(":")[0]
            del agent["move"]
    for agent in state["agents"]:  # a prompted agent works for two reads, then waits
        if agent.get("flip") and agent["lists"] % agent.get("period", 1) == 0:
            home = agent["flip"] if isinstance(agent["flip"], str) else "idle"
            agent["agent_status"] = "working" if agent["agent_status"] == home else home
        if agent.get("ticks"):
            agent["ticks"] -= 1
            agent["agent_status"] = "working" if agent["ticks"] else "idle"
elif head == ["tab", "create"]:
    ok({"root_pane": new_pane(option("--workspace"))})
elif head == ["workspace", "create"]:
    state["n"] += 1
    ok({"root_pane": new_pane(f"w{state['n']}")})
elif head == ["tab", "rename"]:
    for tab in state["tabs"]:
        if tab["tab_id"] == argv[2]:
            tab["label"] = argv[3]
    ok()
elif head == ["agent", "start"] and "never" in argv[2]:
    print(json.dumps({"error": {"code": "timeout", "message": "timed out waiting for agent startup"}}))
    code = 1
elif head == ["agent", "start"]:
    pane, late = option("--pane"), "late" in argv[2]
    if late:
        print(json.dumps({"error": {"code": "timeout", "message": "timed out waiting for agent startup"}}))
        code = 1
    state["agents"].append({"name": None if late else argv[2], "hidden": 3 if late else 0, "pane_id": pane, "tab_id": pane.replace(":p", ":t"), "workspace_id": pane.split(":")[0],
                        "agent": "claude", "agent_status": "idle", "interactive_ready": "trust" not in argv[2],
                        "screen": "Yes, I trust this folder" if "trust" in argv[2] else "", **({"move": "w99:p99"} if "moving" in argv[2] else {})})
    if "busy" in argv[2]:  # a pane that took its kick-off by another way and works, never reading ready
        state["agents"][-1].update(interactive_ready=False, agent_status="working", screen="Run the teamwork:kick-off skill with these arguments: worker " + argv[2])
    if not late:
        ok()
elif head == ["agent", "read"] and by_pane(argv[2]) or head == ["pane", "read"]:  # a pane reads even with no agent in it, as start-session.py tells a reader
    print(by_pane(argv[2]).get("screen", ""))
elif head[0] in ("agent", "pane") and head[1] in ("prompt", "send-keys", "read", "rename", "send-text") and not (by_pane(argv[2]) and not by_pane(argv[2]).get("hidden")):
    print(json.dumps({"error": {"code": "agent_not_found", "message": f"no agent {argv[2]}"}}))
    code = 1
elif head == ["agent", "rename"]:
    by_pane(argv[2])["name"] = argv[3]
    ok()
elif head == ["pane", "send-text"]:
    agent = by_pane(argv[2])
    if agent.get("agent_status") == "blocked":
        agent["agent_status"], agent["screen"], agent["answered"] = "working", "", argv[3]
    ok()
elif head == ["agent", "prompt"]:
    agent = by_pane(argv[2])
    if argv[3].startswith("/rename ") and os.environ.get("TEAMWORK_FAKE_HERDR_CONFIG") and agent.get("agent_session"):
        transcript = pathlib.Path(os.environ["TEAMWORK_FAKE_HERDR_CONFIG"]) / "projects" / "fake" / f"{agent['agent_session']['value']}.jsonl"
        transcript.parent.mkdir(parents=True, exist_ok=True)
        with transcript.open("a") as file:
            file.write(json.dumps({"type": "custom-title", "customTitle": argv[3].split(" ", 1)[1]}, separators=(",", ":")) + "\n")
    if "refuse" in agent.get("name", ""):
        print(json.dumps({"error": {"code": "agent_pane_closed", "message": "pane closed"}}))
        code = 1
    elif agent.get("agent_status") == "blocked" or "unblock" in agent.get("name", "") and not agent.get("refused"):
        agent["refused"] = True
        print(json.dumps({"error": {"code": "agent_blocked", "message": "agent is blocked"}}))
        code = 1
    else:
        if argv[3] == "/exit":
            state["agents"].remove(agent)
        elif "slow" in agent["name"]:
            agent["screen"] = argv[3]
        elif "unseen" not in agent["name"]:
            agent["agent_status"], agent["ticks"] = "working", 2
        ok()
elif head == ["agent", "send-keys"]:
    agent, keys = by_pane(argv[2]), argv[3:]
    if "trust" in agent.get("screen", "") and keys == ["down", "enter"]:
        agent["interactive_ready"], agent["screen"] = True, ""
    elif "Background work" in agent.get("screen", "") and keys == ["enter"]:
        state["agents"].remove(agent)
    elif agent.get("screen") and keys == ["enter"]:
        agent["agent_status"], agent["ticks"], agent["screen"] = "working", 2, ""
    ok()
elif head == ["agent", "wait"]:
    agent, until = by_pane(argv[2]), [argv[i + 1] for i, word in enumerate(argv) if word == "--until"]
    if agent.get("agent_status") == "working":  # its turn ends
        agent["agent_status"], agent["ticks"] = "idle", 0
    if agent.get("agent_status") in until:
        ok({"agent": agent})
    else:
        print(json.dumps({"error": {"code": "timeout", "message": "wait timed out"}}))
        code = 1
elif head == ["tab", "list"]:
    ok({"tabs": [tab for tab in state["tabs"] if tab["workspace_id"] == option("--workspace")]})
elif head == ["pane", "list"]:
    ok({"panes": [{key: agent[key] for key in ("pane_id", "tab_id", "workspace_id")} for agent in state["agents"] if not agent.get("hidden")]})
elif head[1:] == ["close"] and head[0] in ("pane", "tab", "workspace"):  # a close shuts every agent in that place
    state["agents"] = [agent for agent in state["agents"] if agent[f"{head[0]}_id"] != argv[2]]
    state["tabs"] = [tab for tab in state["tabs"] if head[0] == "pane" or tab[f"{head[0]}_id"] != argv[2]]
    ok()
else:  # a pane rename, which the fake does not show
    ok()
temporary = state_path.with_suffix(f".{os.getpid()}")  # replaced whole, since callers run at once
temporary.write_text(json.dumps(state))
os.replace(temporary, state_path)
sys.exit(code)
