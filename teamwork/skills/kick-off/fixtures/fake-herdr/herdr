#!/usr/bin/env python3
"""A stand-in for herdr that logs each call and keeps agents, tabs and workspaces in a JSON state file.

An agent's name picks the dialog it shows: `trust` the folder trust dialog at start, `slow` its prompt typed but unsent,
and a `blocked` agent with a `screen` the exit dialog of background work; each clears on the key that answers it.
A prompt to a `blocked` agent is refused `agent_blocked`, an `unblock` agent refuses its first prompt so, and an `unseen` agent
takes a prompt but never shows it, and a `refuse` agent refuses every prompt `agent_pane_closed`; `agent wait` ends a working
agent's turn at once and times out on a blocked one, and an agent with `move`, or one started with `moving` in its
name, moves to that pane after the `move_after`th list that shows it (default the first). A target no agent has is refused
`agent_not_found`; with FAKE_HERDR_HOME set, a `/rename <name>` prompt is recorded in that home's transcript, as
Claude Code does. FAKE_HERDR_BREAK=accept takes every prompt and every wait instead."""
import json, os, pathlib, sys

state_path = pathlib.Path(os.environ["FAKE_HERDR_STATE"])
s = json.loads(state_path.read_text())
argv = sys.argv[1:]
with open(os.environ.get("FAKE_HERDR_LOG", os.devnull), "a") as log:
    log.write(json.dumps(argv) + "\n")
code = 0
BREAK = os.environ.get("FAKE_HERDR_BREAK") == "accept"
ok = lambda r=None: print(json.dumps({"result": r or {}}))


def new_pane(workspace):
    s["n"] += 1
    s["tabs"].append({"tab_id": f"{workspace}:t{s['n']}", "workspace_id": workspace, "label": ""})
    return {"pane_id": f"{workspace}:p{s['n']}", "tab_id": f"{workspace}:t{s['n']}"}


def by_pane(pane):
    return next((a for a in s["agents"] if pane in (a["pane_id"], a["name"])), {})


def opt(name):
    return argv[argv.index(name) + 1] if name in argv else None


head = argv[:2]
if head == ["agent", "list"]:
    ok({"agents": [{k: v for k, v in a.items() if k not in ("ticks", "screen", "move", "move_after", "lists")} for a in s["agents"]]})
    for a in s["agents"]:  # a pane herdr moved, as from w9:p1 to w4:pF
        a["lists"] = a.get("lists", 0) + 1
        if a.get("move") and a["lists"] >= a.get("move_after", 1):
            a["pane_id"], a["tab_id"], a["workspace_id"] = a["move"], a["move"].replace(":p", ":t"), a["move"].split(":")[0]
            del a["move"]
    for a in s["agents"]:  # a prompted agent works for two reads, then waits
        if a.get("ticks"):
            a["ticks"] -= 1
            a["agent_status"] = "working" if a["ticks"] else "idle"
elif head == ["pane", "get"]:
    ok({"pane": {"pane_id": argv[2], "workspace_id": argv[2].split(":")[0]}})
elif head == ["tab", "create"]:
    ok({"root_pane": new_pane(opt("--workspace"))})
elif head == ["workspace", "create"]:
    s["n"] += 1
    ok({"root_pane": new_pane(f"w{s['n']}")})
elif head == ["tab", "rename"]:
    for t in s["tabs"]:
        if t["tab_id"] == argv[2]:
            t["label"] = argv[3]
    ok()
elif head == ["agent", "start"]:
    pane = opt("--pane")
    s["agents"].append({"name": argv[2], "pane_id": pane, "tab_id": pane.replace(":p", ":t"), "workspace_id": pane.split(":")[0],
                        "agent": "claude", "agent_status": "idle", "interactive_ready": "trust" not in argv[2],
                        "screen": "Yes, I trust this folder" if "trust" in argv[2] else "", **({"move": "w99:p99"} if "moving" in argv[2] else {})})
    ok()
elif head == ["agent", "read"]:
    print(by_pane(argv[2]).get("screen", ""))
elif head[0] in ("agent", "pane") and head[1] in ("prompt", "send-keys", "read", "rename", "send-text") and not by_pane(argv[2]):
    print(json.dumps({"error": {"code": "agent_not_found", "message": f"no agent {argv[2]}"}}))
    code = 1
elif head == ["agent", "rename"]:
    by_pane(argv[2])["name"] = argv[3]
    ok()
elif head == ["pane", "send-text"]:
    a = by_pane(argv[2])
    if a.get("agent_status") == "blocked":
        a["agent_status"], a["screen"], a["answered"] = "working", "", argv[3]
    ok()
elif head == ["agent", "prompt"]:
    a = by_pane(argv[2])
    if argv[3].startswith("/rename ") and os.environ.get("FAKE_HERDR_HOME") and a.get("agent_session"):
        transcript = pathlib.Path(os.environ["FAKE_HERDR_HOME"]) / ".claude" / "projects" / "fake" / f"{a['agent_session']['value']}.jsonl"
        transcript.parent.mkdir(parents=True, exist_ok=True)
        with transcript.open("a") as f:
            f.write(json.dumps({"type": "custom-title", "customTitle": argv[3].split(" ", 1)[1]}, separators=(",", ":")) + "\n")
    if BREAK:
        a["agent_status"], a["ticks"] = "working", 2
        ok()
    elif "refuse" in a.get("name", ""):
        print(json.dumps({"error": {"code": "agent_pane_closed", "message": "pane closed"}}))
        code = 1
    elif a.get("agent_status") == "blocked" or "unblock" in a.get("name", "") and not a.get("refused"):
        a["refused"] = True
        print(json.dumps({"error": {"code": "agent_blocked", "message": "agent is blocked"}}))
        code = 1
    else:
        if argv[3] == "/exit":
            s["agents"].remove(a)
        elif "slow" in a["name"]:
            a["screen"] = argv[3]
        elif "unseen" not in a["name"]:
            a["agent_status"], a["ticks"] = "working", 2
        ok()
elif head == ["agent", "send-keys"]:
    a, keys = by_pane(argv[2]), argv[3:]
    if "trust" in a.get("screen", "") and keys == ["down", "enter"]:
        a["interactive_ready"], a["screen"] = True, ""
    elif "Background work" in a.get("screen", "") and keys == ["enter"]:
        s["agents"].remove(a)
    elif a.get("screen") and keys == ["enter"]:
        a["agent_status"], a["ticks"], a["screen"] = "working", 2, ""
    ok()
elif head == ["agent", "wait"]:
    a, until = by_pane(argv[2]), [argv[i + 1] for i, w in enumerate(argv) if w == "--until"]
    if a.get("agent_status") == "working":  # its turn ends
        a["agent_status"], a["ticks"] = "idle", 0
    if a.get("agent_status") in until or BREAK:
        ok({"agent": a})
    else:
        print(json.dumps({"error": {"code": "timeout", "message": "wait timed out"}}))
        code = 1
elif head == ["tab", "list"]:
    ok({"tabs": [t for t in s["tabs"] if t["workspace_id"] == opt("--workspace")]})
else:  # renames, keys, closes
    ok()
tmp = state_path.with_suffix(f".{os.getpid()}")  # replaced whole, since callers run at once
tmp.write_text(json.dumps(s))
os.replace(tmp, state_path)
sys.exit(code)
