{
 "version": "1",
 "title": "Kick-off route",
 "plan": {
  "intent": "How does kick-off route the owner's words through a manager, workers and a judge to a merged pull request?"
 },
 "scenarios": [
  {
   "slug": "land-owner-request",
   "text": "When the owner states new work, the manager routes it and a worker lands it judged and merged.",
   "walk": [
    {
     "place": "intent",
     "does": "The owner states the work.",
     "expects": "Words exist."
    },
    {
     "place": "triage",
     "does": "The manager triages the words.",
     "expects": "A backlog exists."
    },
    {
     "place": "route",
     "does": "The manager routes the backlog.",
     "expects": "A worker holds it."
    },
    {
     "place": "work",
     "does": "The manager hands the backlog to a worker.",
     "expects": "The worker starts.",
     "edge": "assignment"
    },
    {
     "place": "define",
     "does": "The worker defines tasks.",
     "expects": "Tasks with criteria exist."
    },
    {
     "place": "check",
     "does": "The manager checks the Goal.",
     "expects": "The Goal is decided.",
     "edge": "tasks to check"
    },
    {
     "place": "build",
     "does": "The worker builds the task.",
     "expects": "A pull request exists.",
     "edge": "checked goal"
    },
    {
     "place": "judge",
     "does": "A judge reads the change.",
     "expects": "The verdict is approve."
    },
    {
     "place": "merge",
     "does": "The worker merges.",
     "expects": "The change is in the default branch."
    },
    {
     "place": "close",
     "does": "The worker closes the task.",
     "expects": "The task is resolved."
    },
    {
     "place": "reconcile",
     "does": "The manager closes the gap.",
     "expects": "No gap is left.",
     "edge": "report"
    }
   ]
  },
  {
   "slug": "ask-owner-unclear-goal",
   "text": "When the manager cannot judge a Goal, it asks the owner.",
   "walk": [
    {
     "place": "check",
     "does": "The manager cannot judge the Goal.",
     "expects": "A question is ready."
    },
    {
     "place": "intent",
     "does": "The manager asks the owner.",
     "expects": "The owner answers."
    }
   ]
  },
  {
   "slug": "fix-judged-change",
   "text": "When a judge replies fix, the worker fixes the cause and asks again.",
   "walk": [
    {
     "place": "build",
     "does": "The worker builds.",
     "expects": "A pull request exists."
    },
    {
     "place": "judge",
     "does": "A judge replies fix.",
     "expects": "Gaps are listed."
    },
    {
     "place": "build",
     "does": "The worker fixes each gap.",
     "expects": "The change is ready again."
    }
   ]
  },
  {
   "slug": "route-next-step",
   "text": "When a batch lands and the backlog stays open, the manager routes the next step.",
   "walk": [
    {
     "place": "reconcile",
     "does": "The manager sees the open backlog.",
     "expects": "A next step is proposed."
    },
    {
     "place": "route",
     "does": "The manager routes it.",
     "expects": "A worker holds it."
    }
   ]
  },
  {
   "slug": "track-backlog",
   "text": "When a backlog is routed, worked and resolved, it passes open, held and closed.",
   "walk": [
    {
     "place": "route",
     "does": "The manager routes the backlog.",
     "expects": "A holder is decided."
    },
    {
     "place": "open-s",
     "does": "The backlog is open.",
     "expects": "No worker holds it."
    },
    {
     "place": "held-s",
     "does": "The manager decides a holder.",
     "expects": "A worker holds it.",
     "edge": "decide holder"
    },
    {
     "place": "held-s",
     "does": "A batch lands.",
     "expects": "The backlog stays open.",
     "edge": "report batch"
    },
    {
     "place": "closed-s",
     "does": "The worker resolves it.",
     "expects": "The backlog is closed.",
     "edge": "resolve"
    }
   ]
  },
  {
   "slug": "defer-backlog",
   "text": "When a backlog may wait, the manager leaves it open for later.",
   "walk": [
    {
     "place": "route",
     "does": "The manager sees a gap.",
     "expects": "The gap names route."
    },
    {
     "place": "open-s",
     "does": "The backlog is unrouted.",
     "expects": "No worker holds it."
    },
    {
     "place": "deferred-s",
     "does": "The manager defers it.",
     "expects": "The route gap is silent.",
     "edge": "defer"
    }
   ]
  },
  {
   "slug": "stop-backlog",
   "text": "When the owner stops work, the backlog closes as not planned.",
   "walk": [
    {
     "place": "route",
     "does": "The owner stops the work.",
     "expects": "The manager hears it."
    },
    {
     "place": "open-s",
     "does": "The backlog is open.",
     "expects": "No worker holds it."
    },
    {
     "place": "closed-s",
     "does": "The manager resolves it not planned.",
     "expects": "The backlog is closed."
    }
   ]
  },
  {
   "slug": "reopen-backlog",
   "text": "When a follow-up comes for a delivered backlog, the manager reopens it.",
   "walk": [
    {
     "place": "route",
     "does": "The owner asks a follow-up.",
     "expects": "The manager finds the closed backlog."
    },
    {
     "place": "closed-s",
     "does": "The backlog is closed.",
     "expects": "Its work was delivered."
    },
    {
     "place": "open-s",
     "does": "The manager reopens it.",
     "expects": "The backlog is open."
    }
   ]
  },
  {
   "slug": "see-why-merge-needs-approval",
   "text": "To see why a merge needs a judge, follow the pull request to its author and the worktree.",
   "walk": [
    {
     "place": "work",
     "does": "A worker takes the task.",
     "expects": "It will build."
    },
    {
     "place": "build",
     "does": "The worker builds.",
     "expects": "A pull request exists."
    },
    {
     "place": "pr",
     "does": "The pull request is judged at its head.",
     "expects": "Only an approved head merges."
    },
    {
     "place": "worker",
     "does": "A worker made it and merges it.",
     "expects": "The merger is its author."
    },
    {
     "place": "worktree",
     "does": "The worker edited its own worktree.",
     "expects": "No other worktree is touched."
    }
   ]
  },
  {
   "slug": "route-deferred-backlog",
   "text": "When a deferred backlog is due, the manager decides its holder.",
   "walk": [
    {
     "place": "route",
     "does": "The manager picks a deferred backlog.",
     "expects": "It is due."
    },
    {
     "place": "deferred-s",
     "does": "The backlog is deferred.",
     "expects": "Its route gap is silent."
    },
    {
     "place": "held-s",
     "does": "The manager decides a holder.",
     "expects": "A worker holds it."
    }
   ]
  },
  {
   "slug": "stop-deferred-backlog",
   "text": "When the owner stops deferred work, the backlog closes as not planned.",
   "walk": [
    {
     "place": "route",
     "does": "The owner stops the work.",
     "expects": "The manager hears it."
    },
    {
     "place": "deferred-s",
     "does": "The backlog is deferred.",
     "expects": "No worker holds it."
    },
    {
     "place": "closed-s",
     "does": "The manager resolves it not planned.",
     "expects": "The backlog is closed."
    }
   ]
  },
  {
   "slug": "review-tasks",
   "text": "When a worker defines tasks, a judge reviews them and the worker fixes each gap.",
   "walk": [
    {
     "place": "define",
     "does": "The worker files tasks.",
     "expects": "Tasks exist.",
     "edge": "assignment"
    },
    {
     "place": "judge",
     "does": "A judge reviews the tasks.",
     "expects": "The gaps are listed.",
     "edge": "tasks for review"
    },
    {
     "place": "define",
     "does": "The worker fixes the tasks.",
     "expects": "The tasks are ready.",
     "edge": "task gaps"
    }
   ]
  },
  {
   "slug": "rejudge-moved-head",
   "text": "When the head moves after approval, a judge reads the new head before any merge.",
   "walk": [
    {
     "place": "merge",
     "does": "The worker finds a new head.",
     "expects": "The approval is old."
    },
    {
     "place": "judge",
     "does": "A judge reads the new head.",
     "expects": "A new verdict names it.",
     "edge": "head moved"
    }
   ]
  }
 ],
 "operations": [],
 "rules": [
  {
   "slug": "merge-only-approved-head",
   "kind": "must",
   "formula": "Merged in ApprovedHead",
   "text": "A merged pull request has a judge's approval of its head."
  },
  {
   "slug": "one-worktree-per-worker",
   "kind": "must",
   "formula": "all worker: Worker | one worker.worktree",
   "text": "A worker edits in one worktree of its own."
  }
 ],
