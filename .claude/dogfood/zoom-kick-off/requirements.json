{
 "version": "1",
 "title": "Kick-off as required",
 "plan": {
  "intent": "What must the kick-off rules make true when an owner's words reach merged work: one changer per resource, and no merge without a judge's approval of the head?"
 },
 "scenarios": [
  {
   "slug": "land-approved-change",
   "text": "When a worker's change is approved at its head, its pull request merges and the manager hears of it.",
   "walk": [
    {
     "place": "session",
     "does": "A worker session starts its run.",
     "expects": "The run begins."
    },
    {
     "place": "triage",
     "does": "The manager triages the owner's words.",
     "expects": "A backlog exists."
    },
    {
     "place": "route",
     "does": "The manager routes the backlog.",
     "expects": "A worker holds it."
    },
    {
     "place": "define",
     "does": "The worker defines the tasks.",
     "expects": "Tasks with criteria exist."
    },
    {
     "place": "build",
     "does": "The worker builds the change in its worktree.",
     "expects": "A pull request exists."
    },
    {
     "place": "judge",
     "does": "A judge reads the change.",
     "expects": "The verdict is approve."
    },
    {
     "place": "merge",
     "does": "The worker merges the pull request.",
     "expects": "The change is in the default branch."
    },
    {
     "place": "reconcile",
     "does": "The manager closes the gap.",
     "expects": "No gap is left."
    }
   ]
  },
  {
   "slug": "edit-one-resource",
   "text": "When two sessions need the same resource, one changes it after the other stops.",
   "walk": [
    {
     "place": "build",
     "does": "A worker builds in its worktree.",
     "expects": "The worker holds the resource."
    },
    {
     "place": "idle-s",
     "does": "The session waits.",
     "expects": "It changes nothing."
    },
    {
     "place": "editing-s",
     "does": "The session begins to edit the resource.",
     "expects": "No other session edits it."
    },
    {
     "place": "idle-s",
     "does": "The session ends its edit.",
     "expects": "The resource is free."
    }
   ]
  },
  {
   "slug": "merge-after-approval",
   "text": "When a judge approves the head, the pull request merges; an older approval does not count.",
   "walk": [
    {
     "place": "merge",
     "does": "The worker lands the pull request.",
     "expects": "The pull request is open."
    },
    {
     "place": "open-s",
     "does": "The pull request is open.",
     "expects": "It has a head."
    },
    {
     "place": "open-s",
     "does": "The worker pushes a commit.",
     "expects": "The head is the new commit.",
     "edge": "push commit"
    },
    {
     "place": "open-s",
     "does": "A judge's review of the head is recorded.",
     "expects": "The pull request holds an approval of its head.",
     "edge": "record review"
    },
    {
     "place": "merged-s",
     "does": "The worker merges the pull request.",
     "expects": "The pull request is merged."
    }
   ]
  },
  {
   "slug": "fix-judged-change",
   "text": "When a judge replies fix, the worker fixes the cause and asks again.",
   "walk": [
    {
     "place": "build",
     "does": "The worker builds the change.",
     "expects": "A pull request exists."
    },
    {
     "place": "judge",
     "does": "A judge replies fix.",
     "expects": "The gaps are listed."
    },
    {
     "place": "build",
     "does": "The worker fixes each gap.",
     "expects": "The change is ready to judge again."
    }
   ]
  },
  {
   "slug": "check-goal-first",
   "text": "When a worker defines tasks, its manager checks the Goal before any build.",
   "walk": [
    {
     "place": "define",
     "does": "The worker asks by BLOCKED.",
     "expects": "It builds nothing while it waits."
    },
    {
     "place": "route",
     "does": "The manager checks the Goal against the owner's words.",
     "expects": "The answer is decided."
    },
    {
     "place": "define",
     "does": "The worker takes the answer.",
     "expects": "The Goal stands."
    }
   ]
  },
  {
   "slug": "route-next-step",
   "text": "When a batch lands but the backlog stays open, the manager routes the next step.",
   "walk": [
    {
     "place": "merge",
     "does": "The worker hands over the urls.",
     "expects": "The manager has them."
    },
    {
     "place": "reconcile",
     "does": "The manager sees the gap.",
     "expects": "The next step is proposed."
    },
    {
     "place": "route",
     "does": "The manager routes the next step.",
     "expects": "A worker holds it."
    }
   ]
  },
  {
   "slug": "see-why-merge-needs-approval",
   "text": "To see why a merge needs a judge, follow the pull request to the review that names its head.",
   "walk": [
    {
     "place": "session",
     "does": "A worker session works on a pull request.",
     "expects": "The pull request is known."
    },
    {
     "place": "pr",
     "does": "The pull request names its head commit.",
     "expects": "One head is current."
    },
    {
     "place": "commit",
     "does": "The head is the commit a review must read.",
     "expects": "The review's commit is compared with it."
    },
    {
     "place": "review",
     "does": "A review carries a verdict on one commit.",
     "expects": "Only approve at the head counts."
    },
    {
     "place": "judge-c",
     "does": "A judge wrote the review.",
     "expects": "The author is a judge."
    },
    {
     "place": "review",
     "does": "The review collects under the pull request.",
     "expects": "The pull request knows its reviews."
    },
    {
     "place": "pr",
     "does": "The pull request is merged only with such a review.",
     "expects": "No merge without approval."
    },
    {
     "place": "session",
     "does": "The worker goes on with its run.",
     "expects": "The run continues."
    },
    {
     "place": "merge",
     "does": "The worker merges the pull request.",
     "expects": "The merge waits for the approval."
    }
   ]
  },
  {
   "slug": "see-why-one-session-edits",
   "text": "To see why a resource has one changer, follow the session to the resource it edits.",
   "walk": [
    {
     "place": "session",
     "does": "A session names the resources it edits.",
     "expects": "It edits a set."
    },
    {
     "place": "resource",
     "does": "The resource is a worktree or a file outside every worktree.",
     "expects": "Two sessions would clash on it."
    },
    {
     "place": "session",
     "does": "The session goes on with its run.",
     "expects": "The run continues."
    },
    {
     "place": "build",
     "does": "The worker builds in its worktree.",
     "expects": "It is the only changer of the resource."
    }
   ]
  }
 ],
 "operations": [
  {
   "slug": "Session.beginEdit",
   "sig": "(resource: Resource) \u2192 Session",
   "text": "The session starts changing a worktree or a file outside every worktree.",
   "post": "after (resource in self.edits)",
   "modifies": [
    "Session.edits"
   ]
  },
  {
   "slug": "Session.endEdit",
   "sig": "(resource: Resource) \u2192 Session",
   "text": "The session stops changing the resource.",
   "post": "after (resource not in self.edits)",
   "modifies": [
    "Session.edits"
   ]
  },
  {
   "slug": "PullRequest.push",
   "sig": "(commit: Commit) \u2192 PullRequest",
   "text": "The worker pushes a new head to the pull request.",
   "post": "after (self.head = commit)",
   "modifies": [
    "PullRequest.head"
   ]
  },
  {
   "slug": "PullRequest.record",
   "sig": "(review: Review) \u2192 PullRequest",
   "text": "A judge's review is recorded on the pull request.",
   "post": "after (review in self.reviews)",
   "modifies": [
    "PullRequest.reviews"
   ]
  },
  {
   "slug": "PullRequest.merge",
   "sig": "() \u2192 PullRequest",
   "text": "The worker merges the pull request into the default branch."
  }
 ],
 "rules": [
  {
   "slug": "one-holder-per-resource",
   "kind": "must",
   "formula": "all session: Session, res: Resource, out: Session | session.beginEdit[res, out] implies no other: Session - session | res in other.edits",
   "text": "A session may start changing a resource only when no other session is changing it."
  },
  {
   "slug": "never-merge-unapproved",
   "kind": "must",
   "formula": "all pr: PullRequest | pr.merge implies some review: pr.reviews | review.verdict = approve and review.commit = pr.head",
   "text": "A pull request merges only when a judge approved its current head."
  }
 ],
