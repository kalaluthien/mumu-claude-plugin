{
  "enabledPlugins": { "teamwork@mumu-claude-plugin": true },
  "extraKnownMarketplaces": { "mumu-claude-plugin": { "source": { "source": "github", "repo": "kalaluthien/mumu-claude-plugin" } } },
  "hooks": {
    "SessionStart": [{ "hooks": [
      { "type": "command", "command": "echo PROBE-SESSIONSTART-MARKER; date -u +%FT%TZ >> /tmp/probe-hooks.log" },
      { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/teamwork/hooks/route-event.py", "timeout": 30 }
    ] }],
    "PreToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/teamwork/hooks/route-event.py" }] }],
    "PostToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/teamwork/hooks/route-event.py" }] }],
    "Stop": [{ "hooks": [
      { "type": "command", "command": "echo stop >> /tmp/probe-hooks.log" },
      { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/teamwork/hooks/route-event.py", "timeout": 30 }
    ] }]
  }
}
