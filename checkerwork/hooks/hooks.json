{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "echo 'Before changing what code, a prompt or a skill does, load checkerwork:contract, even when the request asks only for the change.'" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/run-verify.py" }] }
    ],
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/run-verify.py" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/commit-nudge.py" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/run-verify.py" }] }
    ]
  }
}
